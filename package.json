{
  "name": "tracecase",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous, deterministic web defect reproduction and verifiable evidence pipeline",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:worker": "tsx worker/index.ts",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "next build",
    "build:worker": "tsup worker/index.ts --format esm --out-dir dist/worker",
    "start": "next start --port 3000",
    "start:worker": "node dist/worker/index.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "lucide-react": "^0.473.0",
    "next": "15.1.7",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.3"
  },
  "packageManager": "pnpm@9.15.9"
}
