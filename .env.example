# ==============================================================================
# TraceCase — Shared Environment Configuration Template
# All values are development defaults. ZERO production secrets belong here.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database & Drizzle ORM
DATABASE_URL=postgres://tc_user:tc_pass@localhost:5432/tracecase

# AI Integration (OpenAI GPT-6 Luna only; TC-INV-001)
# Note: Stage 0 does not require an active key. Leave blank for development preview.
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Budget & Usage Ceilings (USD)
OPENAI_TOTAL_BUDGET_CEILING=10.00
OPENAI_PER_INVESTIGATION_CEILING=0.25
OPENAI_SESSION_VERIFICATION_CEILING=1.00
OPENAI_MAX_OUTPUT_TOKENS=2048

# MinIO / S3 Object Storage (Dual-Bucket Architecture; TC-INV-009)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tracecase_admin
S3_SECRET_KEY=tracecase_secret_key_2026
S3_BUCKET_PUBLIC=tracecase-public-safe
S3_BUCKET_RESTRICTED=tracecase-restricted-raw
S3_REGION=us-east-1

# Persistent Browser Worker Daemon
WORKER_PORT=3001
WORKER_CONCURRENCY=1
WORKER_HEARTBEAT_SEC=10

# Development Preview & Simulation Mode
# Set to 'true' to enable synthetic workflow previews without backend/AI services
DEV_PREVIEW_MODE=true

# Safety Guardrails & Policy Engine
POLICY_ENFORCE_SANDBOX=true
TARGET_RESET_SECRET=tc-fixture-secret-2026
